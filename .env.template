# Configuración del servidor
PORT=3000

# MongoDB Atlas Connection String
# Reemplaza <username>, <password> y <cluster> con tus credenciales de MongoDB Atlas
MONGODB_URI=mongodb+srv://user:<db_password>@cluster0.a4x9p3s.mongodb.net/?appName=Cluster0

# JWT Secret (clave secreta para firmar tokens)
# Genera una clave segura usando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_clave_secreta_super_segura_aqui
